<Window x:Class="SnapDrop.App.FloatingPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot — SnapDrop" Width="320" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" KeyDown="WindowKeyDown">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ThumbnailRadius}" Padding="12">
    <StackPanel>
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Style="{StaticResource IconButton}" ToolTip="Dismiss; recovery remains available while retained" AutomationProperties.Name="Dismiss screenshot preview" Margin="4,0,0,0"><Path Data="{StaticResource Icon.Close}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
        <CheckBox x:Name="PinToggle" DockPanel.Dock="Right" Content="Pin" IsChecked="{Binding IsPinned}" Checked="PinChanged" Unchecked="PinChanged" AutomationProperties.Name="Pin this preview" Margin="4,0"/>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="SnapDrop" FontWeight="SemiBold"/><TextBlock Text="{Binding Item.Details}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
      </DockPanel>
      <Border Background="{DynamicResource InputBrush}" CornerRadius="{StaticResource ControlRadius}" Padding="4"><Image x:Name="ThumbnailImage" Source="{Binding Item.Thumbnail}" Height="126" Stretch="Uniform" MouseLeftButtonDown="ImageDown" MouseMove="ImageMove" MouseLeftButtonUp="ImageUp" ToolTip="Drag to copy a PNG file. Click to open preview." AutomationProperties.Name="Screenshot; drag to copy a file"/></Border>
      <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}">
        <UniformGrid Columns="4" Margin="0,10,0,0">
          <Button Content="Copy" Command="{Binding CopyCommand}" Padding="5,8" Margin="0,0,4,0"/>
          <Button Content="Save As…" Command="{Binding SaveAsCommand}" Padding="5,8" Margin="0,0,4,0"/>
          <Button Content="Save" Command="{Binding SaveCommand}" Padding="5,8" Margin="0,0,4,0"/>
          <Button Content="More" Click="MoreClick" Padding="5,8"><Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Open preview" Command="{Binding OpenCommand}"/><MenuItem Header="Keep / release recovery copy" Command="{Binding KeepCommand}"/>
              <MenuItem Header="Open recovery folder" Command="{Binding FolderCommand}"/><Separator/>
              <MenuItem Header="Screenshot history" Command="{Binding HistoryCommand}"/><MenuItem Header="Settings" Command="{Binding SettingsCommand}"/>
            </ContextMenu>
          </Button.ContextMenu></Button>
        </UniformGrid>
      </StackPanel>
      <TextBlock Text="{Binding Item.Status}" TextWrapping="Wrap" MaxHeight="40" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
  </Border>
</Window>
