<Window x:Class="SnapDrop.App.RecentCapturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recent captures — SnapDrop" Width="760" Height="650" MinWidth="500" MinHeight="360">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel Margin="0,0,0,10">
        <Button Content="Refresh" Click="RefreshClick" DockPanel.Dock="Right" Margin="0" />
        <TextBlock Text="Recent captures" FontSize="24" FontWeight="SemiBold" />
      </DockPanel>
      <TextBlock x:Name="PolicyText" TextWrapping="Wrap" Margin="0,0,0,12" />
      <WrapPanel Margin="0,0,0,12">
        <Button Content="Open preview" Click="OpenClick" /><Button Content="Copy" Click="CopyClick" />
        <Button Content="Save As…" Click="SaveAsClick" /><Button Content="Keep / release" Click="KeepClick" />
        <Button Content="Delete recovery copy" Click="DeleteClick" />
      </WrapPanel>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="MoreButton" Content="Load more" Click="MoreClick" DockPanel.Dock="Right" Margin="8,0,0,0" />
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
    <ListBox x:Name="CaptureList" SelectionMode="Single" MouseDoubleClick="OpenClick" AutomationProperties.Name="Recent screenshot recovery copies"
             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4,6">
            <Image Source="{Binding Thumbnail}" Width="112" Height="72" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Details}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding RecoveryPolicy}" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBlock Text="Clipboard image" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
