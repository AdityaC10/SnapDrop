<Window x:Class="SnapDrop.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SnapDrop.App.Views"
        Title="SnapDrop" Width="1440" Height="900" MinWidth="1080" MinHeight="680">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
      <DockPanel><TextBlock Text="{Binding Page}" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="7" Margin="0,0,12,0"><Path Data="{StaticResource Icon.Capture}" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform"/></Border><TextBlock Text="SnapDrop" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Left" Width="210" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,22">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MonitoringStatus}" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" Margin="8,16,4,0" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel>
          <RadioButton Content="Home" GroupName="PrimaryNav" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Home" Style="{StaticResource NavigationButton}"/>
          <RadioButton Content="History" GroupName="PrimaryNav" IsChecked="{Binding IsHistory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="History" Style="{StaticResource NavigationButton}"/>
          <RadioButton Content="Settings" GroupName="PrimaryNav" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavigationButton}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Margin="26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibility}}">
        <DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissNoticeCommand}" Margin="16,0,0,0"/><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
      </Border>
      <DockPanel Grid.Row="1" Visibility="{Binding IsGallery, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Capture, preview, and save anywhere — with recovery copies kept on this computer." Style="{StaticResource SecondaryText}" Margin="0,0,0,20"/>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="20" Margin="0,0,0,20" Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel><Button Content="Take screenshot" Style="{StaticResource PrimaryButton}" Command="{Binding Gallery.CaptureCommand}" DockPanel.Dock="Right" Margin="20,0,0,0"/>
              <StackPanel><TextBlock Text="Capture with Windows Snipping Tool" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Win + Shift + S · Windows-owned shortcut" Style="{StaticResource SecondaryText}" Margin="0,7,0,0"/><TextBlock Text="Choose region, window, or screen in Windows. SnapDrop handles the image afterward." Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
        <views:GalleryView DataContext="{Binding Gallery}"/>
      </DockPanel>
      <views:SettingsView Grid.Row="1" DataContext="{Binding Settings}" Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibility}}"/>
    </Grid>
  </DockPanel>
</Window>
