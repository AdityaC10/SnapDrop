<Window x:Class="SnapDrop.App.ScreenshotViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot preview — SnapDrop" Width="1280" Height="800" MinWidth="960" MinHeight="620">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Zoom" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0"/><ComboBox x:Name="Zoom" SelectedIndex="0" SelectionChanged="ZoomChanged" MinWidth="100" AutomationProperties.Name="Image zoom"><ComboBoxItem Content="Fit"/><ComboBoxItem Content="50%"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/></ComboBox></StackPanel>
      <StackPanel><TextBlock Text="Screenshot preview" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Item.Details}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/></StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
      <WrapPanel x:Name="ActionPanel"><Button Content="Copy image" Command="{Binding CopyCommand}" Margin="0,0,8,8"/><Button Content="Save As…" Command="{Binding SaveAsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,8"/><Button Content="Open saved folder" Command="{Binding OpenSavedFolderCommand}" Margin="0,0,8,8"/><Button Content="Done" Command="{Binding CloseCommand}" Margin="0,0,0,8"/></WrapPanel>
      <DockPanel Margin="0,4,0,10" Visibility="{Binding Item.HasHistoryExports, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Saved locations" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="ExportLocations" ItemsSource="{Binding Item.Record.Exports}" SelectedItem="{Binding SelectedExport}" DisplayMemberPath="Path" SelectedIndex="0" AutomationProperties.Name="Previously saved image locations"/></DockPanel>
      <TextBlock Text="{Binding Item.Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Item.RecoveryPolicy}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
    </StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,16,0"><TextBlock Text="Recent" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Recent}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.RecentOpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4" Margin="0,0,0,10" ToolTip="{Binding Details}" AutomationProperties.Name="Open recent screenshot"><Image Source="{Binding Thumbnail}" Height="56" Stretch="Uniform"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel>
      <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="10">
        <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="ViewportChanged"><Image x:Name="FullImage" Source="{Binding Item.Thumbnail}" Stretch="Uniform" MouseLeftButtonDown="ImageDown" MouseMove="ImageMove" AutomationProperties.Name="Full screenshot image" ToolTip="Drag to copy a PNG file"/></ScrollViewer>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="18" Margin="16,0,0,0"><StackPanel>
        <TextBlock Text="Viewer mode" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Original pixels are preserved. Use zoom to inspect details, then copy or export a new file." Style="{StaticResource SecondaryText}" Margin="0,12,0,20"/>
        <Button Content="Keep / release recovery copy" Command="{Binding KeepCommand}"/><Button Content="Open recovery folder" Command="{Binding FolderCommand}" Margin="0,10,0,0"/>
        <TextBlock Text="Editing · planned for 0.3" Style="{StaticResource SectionHeading}"/><TextBlock Text="Annotations, crop, blur, and undo/redo are not included in this viewer. No edits are applied to your original." Style="{StaticResource SecondaryText}"/>
      </StackPanel></Border>
    </Grid>
  </DockPanel>
</Window>
